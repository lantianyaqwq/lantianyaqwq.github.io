---
import Icon from './Icon.astro';

interface Props {
  title: string;
  description: string;
  icon?: 'folder' | 'news' | 'search';
  eyebrow?: string;
  compact?: boolean;
}
const { title, description, icon = 'folder', eyebrow, compact = false } = Astro.props;
const Heading = compact ? 'h3' : 'h2';
---

<div class:list={["empty-state-card", { compact }]}>
  <div class="empty-state-icon" aria-hidden="true"><Icon name={icon} size={compact ? 22 : 28} /></div>
  <div class="empty-state-copy">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <Heading>{title}</Heading>
    <p>{description}</p>
  </div>
</div>
