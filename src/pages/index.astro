---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EmptyState from '../components/EmptyState.astro';
import Icon from '../components/Icon.astro';

const resources = (await getCollection('resources'))
  .sort((a, b) => b.data.published.getTime() - a.data.published.getTime())
  .slice(0, 4);
const news = (await getCollection('news'))
  .sort((a, b) => b.data.published.getTime() - a.data.published.getTime())
  .slice(0, 3);
const formatDate = (date: Date) => new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric', month: '2-digit', day: '2-digit',
}).format(date);
---

<BaseLayout>
  <section class="home-hero" aria-labelledby="home-title">
    <div class="hero-copy">
      <p class="eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span>资源分享 · 每周精选</p>
      <h1 id="home-title">BlueSky 的<br />资源分享博客</h1>
      <p class="hero-description">这里主要整理免费的游戏、工具和网络资源；每周再挑几条值得留意的消息，附来源和一句点评。</p>
      <div class="hero-actions">
        <a class="button primary" href="/resources/">浏览网络资源</a>
        <a class="hero-text-link" href="/news/">查看本周精选 →</a>
      </div>
      <p class="hero-note-line">只收录免费资源，通常每周更新一次。</p>
    </div>

    <div class="hero-art" aria-hidden="true">
      <svg viewBox="0 0 380 290" role="img" focusable="false">
        <defs>
          <linearGradient id="hero-sky" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#dff0f6" />
            <stop offset="0.55" stop-color="#eef5f2" />
            <stop offset="1" stop-color="#f8efd9" />
          </linearGradient>
        </defs>
        <rect x="18" y="18" width="344" height="254" rx="38" fill="url(#hero-sky)" />
        <circle cx="294" cy="79" r="31" fill="#f1c979" opacity="0.86" />
        <path d="M71 129h99a24 24 0 0 0 4-47 37 37 0 0 0-72-5 28 28 0 0 0-31 52Z" fill="#fff" opacity="0.86" />
        <path d="M190 201h103a20 20 0 0 0 3-40 30 30 0 0 0-58-6 24 24 0 0 0-48 46Z" fill="#fff" opacity="0.72" />
        
      </svg>
      
    </div>
  </section>

  <div class="home-grid">
    <section class="content-panel resources-panel" aria-labelledby="latest-resources">
      <div class="section-heading">
        <div class="section-title">
          <span class="section-icon"><Icon name="folder" size={20} /></span>
          <div>
            <p class="section-kicker">Resources</p>
            <h2 id="latest-resources">最近收录</h2>
          </div>
        </div>
        <a class="text-link" href="/resources/">全部资源 <Icon name="arrow" size={15} /></a>
      </div>
      {resources.length === 0 && (
        <EmptyState
          compact
          icon="folder"
          title="还没有收录资源"
          description="第一篇资源发布后，会出现在这里。"
        />
      )}
      <div class="resource-list">
        {resources.map((entry) => (
          <article class="resource-item">
            <div class="item-meta">
              <span>{entry.data.category}</span>
              <time datetime={entry.data.published.toISOString()}>{formatDate(entry.data.published)}</time>
            </div>
            <h3><a href={`/resources/${entry.id}/`}>{entry.data.title}</a></h3>
            <p>{entry.data.description}</p>
            <div class="item-foot">
              <span>{entry.data.platform}</span>
              <span>{entry.data.license}</span>
            </div>
          </article>
        ))}
      </div>
    </section>

    <aside class="content-panel home-news" aria-labelledby="latest-news">
      <div class="section-heading">
        <div class="section-title">
          <span class="section-icon"><Icon name="news" size={20} /></span>
          <div>
            <p class="section-kicker">Weekly</p>
            <h2 id="latest-news">本周热门</h2>
          </div>
        </div>
        <a class="text-link" href="/news/">全部资讯 <Icon name="arrow" size={15} /></a>
      </div>
      {news.length === 0 && (
        <EmptyState
          compact
          icon="news"
          title="本周还没有精选资讯"
          description="有新内容时，再在这里慢慢补上。"
        />
      )}
      <ol class="news-list">
        {news.map((entry) => (
          <li class="news-item">
            <div class="item-meta">
              <span>{entry.data.category}</span>
              <time datetime={entry.data.published.toISOString()}>{formatDate(entry.data.published)}</time>
            </div>
            <h3><a href={`/news/#${entry.id}`}>{entry.data.title}</a></h3>
            <p>{entry.data.description}</p>
          </li>
        ))}
      </ol>
    </aside>
  </div>
</BaseLayout>
