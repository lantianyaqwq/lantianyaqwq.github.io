---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'BlueSky',
  description = 'BlueSky 的资源分享博客，整理免费资源与每周热门资讯。',
} = Astro.props;
const pathname = Astro.url.pathname;
const navItems = [
  { href: '/', label: '首页' },
  { href: '/resources/', label: '网络资源' },
  { href: '/news/', label: '热门资讯' },
  { href: '/about/', label: '关于我' },
];
const isCurrent = (href: string) => href === '/' ? pathname === '/' : pathname.startsWith(href);
const pageTitle = title === 'BlueSky' ? 'BlueSky · 资源分享与每周精选' : `${title} · BlueSky`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f6f3" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href} />
    <link rel="alternate" type="application/rss+xml" title="BlueSky RSS" href={new URL('rss.xml', Astro.site ?? Astro.url.origin).href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/" aria-label="BlueSky 首页">
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" role="img" focusable="false"><path d="M7.2 18h9.1a4.2 4.2 0 0 0 .9-8.3 6.3 6.3 0 0 0-12.2 1.6A3.7 3.7 0 0 0 7.2 18Z" fill="currentColor" /></svg>
          </span>
          <span class="brand-copy">
            <strong>BlueSky<span aria-hidden="true">.</span></strong>
            <small>资源分享博客</small>
          </span>
        </a>
        <nav class="main-nav" aria-label="主导航">
          {navItems.map((item) => (
            <a href={item.href} class:list={[{ active: isCurrent(item.href) }]} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main id="main" class="shell page-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell footer-inner">
        <div class="footer-main">
          <strong>BlueSky<span aria-hidden="true">.</span></strong>
          <p>免费资源与每周精选，由 BlueSky 持续整理。</p>
        </div>
        <div class="footer-meta">
          <span>通常每周更新</span>
          <a href="/rss.xml">RSS 订阅</a>
        </div>
      </div>
    </footer>
  </body>
</html>
